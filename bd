CREATE TABLE IF NOT EXISTS manufacturer (
  id         SERIAL PRIMARY KEY,
  name       VARCHAR(100) NOT NULL,
  start_date DATE
);

CREATE TABLE IF NOT EXISTS product (
  id               SERIAL PRIMARY KEY,
  title            VARCHAR(100) NOT NULL,
  cost             DECIMAL(19,4) NOT NULL,
  description      TEXT,
  main_image_path  VARCHAR(1000),
  is_active        BOOLEAN NOT NULL DEFAULT TRUE,
  manufacturer_id  INT REFERENCES manufacturer(id)
);

CREATE TABLE IF NOT EXISTS gender (
  code CHAR(1) PRIMARY KEY,
  name VARCHAR(10)
);

CREATE TABLE IF NOT EXISTS client (
  id                SERIAL PRIMARY KEY,
  first_name        VARCHAR(50) NOT NULL,
  last_name         VARCHAR(50) NOT NULL,
  patronymic        VARCHAR(50),
  birthday          DATE,
  registration_date TIMESTAMP(6) NOT NULL DEFAULT NOW(),
  email             VARCHAR(255),
  phone             VARCHAR(20) NOT NULL,
  gender_code       CHAR(1) NOT NULL REFERENCES gender(code),
  photo_path        VARCHAR(1000)
);

CREATE TABLE IF NOT EXISTS tag (
  id    SERIAL PRIMARY KEY,
  title VARCHAR(30) NOT NULL,
  color CHAR(6) NOT NULL
);

CREATE TABLE IF NOT EXISTS tag_of_client (
  client_id INT NOT NULL REFERENCES client(id),
  tag_id    INT NOT NULL REFERENCES tag(id),
  PRIMARY KEY (client_id, tag_id)
);

CREATE TABLE IF NOT EXISTS service (
  id                  SERIAL PRIMARY KEY,
  title               VARCHAR(100) NOT NULL,
  cost                DECIMAL(19,4) NOT NULL,
  duration_in_seconds INT NOT NULL,
  description         TEXT,
  discount            DOUBLE PRECISION,
  main_image_path     VARCHAR(1000)
);

CREATE TABLE IF NOT EXISTS service_photo (
  id         SERIAL PRIMARY KEY,
  service_id INT NOT NULL REFERENCES service(id),
  photo_path VARCHAR(1000) NOT NULL
);

CREATE TABLE IF NOT EXISTS client_service (
  id         SERIAL PRIMARY KEY,
  client_id  INT NOT NULL REFERENCES client(id),
  service_id INT NOT NULL REFERENCES service(id),
  start_time TIMESTAMP(6) NOT NULL,
  comment    TEXT
);

CREATE TABLE IF NOT EXISTS product_sale (
  id                SERIAL PRIMARY KEY,
  sale_date         TIMESTAMP(6) NOT NULL,
  product_id        INT NOT NULL REFERENCES product(id),
  quantity          INT NOT NULL,
  client_service_id INT REFERENCES client_service(id)
);

CREATE TABLE IF NOT EXISTS product_photo (
  id         SERIAL PRIMARY KEY,
  product_id INT NOT NULL REFERENCES product(id),
  photo_path VARCHAR(1000) NOT NULL
);

CREATE TABLE IF NOT EXISTS document_by_service (
  id                SERIAL PRIMARY KEY,
  client_service_id INT NOT NULL REFERENCES client_service(id),
  document_path     VARCHAR(1000) NOT NULL
);

CREATE TABLE IF NOT EXISTS attached_product (
  main_product_id     INT NOT NULL REFERENCES product(id),
  attached_product_id INT NOT NULL REFERENCES product(id),
  PRIMARY KEY (main_product_id, attached_product_id)
);

