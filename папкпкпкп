        q: 'Какой фактор НЕ влияет на ликвидность?',
        answers: [
          'Цвет логотипа компании',
          'Структура активов',
          'Скорость оборачиваемости',
          'Сроки погашения обязательств'
        ],
        correct: 0,
        explanation: 'Цвет логотипа не влияет на ликвидность. Факторы: структура активов, качество активов, соотношение сроков погашения активов и обязательств, скорость оборота.'
      },
      {
        q: 'Что показывает коэффициент текущей ликвидности?',
        answers: [
          'Способность покрыть краткосрочные обязательства оборотными активами',
          'Рентабельность продаж',
          'Оборачиваемость дебиторской задолженности',
          'Долю заёмных средств в капитале'
        ],
        correct: 0,
        explanation: 'Коэффициент текущей ликвидности = оборотные активы / краткосрочные обязательства. Показывает, сколько рублей оборотных активов приходится на 1 рубль краткосрочных обязательств.'
      },
      {
        q: 'Подготовительный запас — это:',
        answers: [
          'Запас на время приёмки, разгрузки, сортировки и подготовки к производству',
          'Запас на случай сбоев поставок',
          'Запас на период между двумя поставками',
          'Запас, связанный с технологическим процессом'
        ],
        correct: 0,
        explanation: 'Подготовительный (технологический) запас создаётся на время подготовки материалов к производству: приёмки, разгрузки, сортировки, сушки, обогащения и т.п.'
      }
    ];

    // -------------------- ДОСТИЖЕНИЯ --------------------
    const achievementsList = [
      { id: 'first_step', icon: '🐣', label: 'Первый шаг', condition: (p) => p.correctAnswers >= 1 },
      { id: 'five_correct', icon: '🌟', label: '5 верных', condition: (p) => p.correctAnswers >= 5 },
      { id: 'ten_correct', icon: '🎯', label: '10 верных', condition: (p) => p.correctAnswers >= 10 },
      { id: 'all_correct', icon: '👑', label: 'Все 15!', condition: (p) => p.correctAnswers >= TOTAL_QUESTIONS },
      { id: 'streak3', icon: '🔥', label: 'Серия 3', condition: (p) => p.maxStreak >= 3 },
      { id: 'streak5', icon: '⚡', label: 'Серия 5', condition: (p) => p.maxStreak >= 5 },
      { id: 'score100', icon: '💰', label: '100 очков', condition: (p) => p.score >= 100 },
      { id: 'score300', icon: '💎', label: '300 очков', condition: (p) => p.score >= 300 },
    ];

    // -------------------- СОСТОЯНИЕ ИГРЫ --------------------
    let players = [];
    let currentPlayerIndex = 0;
    let currentQuestionIndex = 0;
    let answered = false;        // был ли отвечен текущий вопрос
    let gameFinished = false;

    // DOM-элементы
    const playersPanel = document.getElementById('playersPanel');
    const progressFill = document.getElementById('progressFill');
    const progressText = document.getElementById('progressText');
    const totalScoreDisplay = document.getElementById('totalScoreDisplay');
    const questionText = document.getElementById('questionText');
    const answersGrid = document.getElementById('answersGrid');
    const feedbackMsg = document.getElementById('feedbackMsg');
    const nextBtn = document.getElementById('nextBtn');
    const restartBtn = document.getElementById('restartBtn');
    const questionScreen = document.getElementById('questionScreen');
    const finalScreen = document.getElementById('finalScreen');
    const finalWinner = document.getElementById('finalWinner');
    const finalScores = document.getElementById('finalScores');
    const playAgainBtn = document.getElementById('playAgainBtn');
    const badgesContainer = document.getElementById('badgesContainer');

    // -------------------- ИНИЦИАЛИЗАЦИЯ / СБРОС --------------------
    function initGame() {
      // Создаём игроков (до 4, все активны для простоты)
      players = [];
      const playerCount = 4;
      for (let i = 0; i < playerCount; i++) {
        players.push({
          id: i,
          name: PLAYER_NAMES[i],
          avatar: PLAYER_AVATARS[i],
          score: 0,
          correctAnswers: 0,
          currentStreak: 0,
          maxStreak: 0,
          achievements: new Set(),
          answersHistory: []   // для отладки, необязательно
        });
      }
      currentPlayerIndex = 0;
      currentQuestionIndex = 0;
      answered = false;
      gameFinished = false;

      // Сброс UI
      finalScreen.classList.add('hidden');
      questionScreen.classList.remove('hidden');
      nextBtn.disabled = true;
      nextBtn.textContent = '➡️ Следующий вопрос';

      renderPlayers();
      updateProgress();
      updateTotalScore();
      renderAchievements();
      loadQuestion(currentQuestionIndex);
    }

    // -------------------- РЕНДЕР ИГРОКОВ --------------------
    function renderPlayers() {
      playersPanel.innerHTML = '';
      players.forEach((p, idx) => {
        const card = document.createElement('div');
        card.className = `player-card ${idx === currentPlayerIndex ? 'active' : ''}`;
        card.dataset.playerId = p.id;
        card.innerHTML = `
          <span class="avatar">${p.avatar}</span>
          <span class="p-name">${p.name}</span>
          <span class="p-score">${p.score}</span>
        `;
        // Переключение игрока по клику (если текущий вопрос не отвечен)
        card.addEventListener('click', () => {
          if (!answered && !gameFinished && idx !== currentPlayerIndex) {
            // Можно переключиться на любого игрока, если ещё не ответили
            currentPlayerIndex = idx;
            renderPlayers();
            // Обновляем UI вопроса (вопрос остаётся, но активный игрок меняется)
            // Сбрасывать не нужно
            // Визуально выделяем активного
            // И разрешаем отвечать выбранному игроку
            // Но если уже ответили, нельзя
            // Перерисовываем кнопки ответов (не блокируем)
            if (!answered) {
              renderAnswers(currentQuestionIndex);
            }
          }
        });
        playersPanel.appendChild(card);
      });
    }

    // -------------------- ПРОГРЕСС --------------------
    function updateProgress() {
      const percent = ((currentQuestionIndex) / TOTAL_QUESTIONS) * 100;
      progressFill.style.width = `${percent}%`;
      progressText.textContent = `${currentQuestionIndex} / ${TOTAL_QUESTIONS}`;
    }

    function updateTotalScore() {
      const total = players.reduce((sum, p) => sum + p.score, 0);
      totalScoreDisplay.textContent = total;
    }

    // -------------------- ЗАГРУЗКА ВОПРОСА --------------------
    function loadQuestion(index) {
      if (index >= TOTAL_QUESTIONS) {
        finishGame();
        return;
      }
      answered = false;
      nextBtn.disabled = true;
      feedbackMsg.textContent = '';
      const q = questions[index];
      questionText.textContent = `${index + 1}. ${q.q}`;
      renderAnswers(index);
      // Обновляем прогресс
      updateProgress();
      // Убедимся, что активный игрок подсвечен
      renderPlayers();
    }

    function renderAnswers(questionIdx) {
      const q = questions[questionIdx];
      answersGrid.innerHTML = '';
      const letters = ['А', 'Б', 'В', 'Г'];
      q.answers.forEach((ans, i) => {
        const btn = document.createElement('button');
        btn.className = 'answer-btn';
        btn.innerHTML = `<span class="answer-prefix">${letters[i]}</span> ${ans}`;
        btn.dataset.index = i;
        btn.addEventListener('click', () => handleAnswer(i));
        // Если уже ответили — блокируем все кнопки
        if (answered) {
          btn.disabled = true;
          // Подсветим правильный/неправильный
          if (i === q.correct) {
            btn.classList.add('correct');
          } else if (i === q.selectedBy && q.selectedBy !== undefined) {
            // не используется
          }
        }
        answersGrid.appendChild(btn);
      });
      // Если ответ уже был выбран (при переключении игрока после ответа — невозможно, т.к. answered=true)
    }

    // -------------------- ОБРАБОТКА ОТВЕТА --------------------
    function handleAnswer(selectedIndex) {
      if (answered || gameFinished) return;

      const q = questions[currentQuestionIndex];
      const isCorrect = (selectedIndex === q.correct);
      answered = true;

      // Блокируем все кнопки и подсвечиваем
      const allBtns = Array.from(answersGrid.querySelectorAll('.answer-btn'));
      allBtns.forEach((btn, i) => {
        btn.disabled = true;
        if (i === q.correct) {
          btn.classList.add('correct');
        }
        if (i === selectedIndex && !isCorrect) {
          btn.classList.add('wrong');
        }
      });

      const player = players[currentPlayerIndex];

      if (isCorrect) {
        player.score += 20;
        player.correctAnswers += 1;
        player.currentStreak += 1;
        if (player.currentStreak > player.maxStreak) {
          player.maxStreak = player.currentStreak;
        }
        feedbackMsg.innerHTML = `✅ <strong>Верно!</strong> +20 очков. ${q.explanation}`;
      } else {
        player.currentStreak = 0;
        // Штраф не начисляем, просто 0
        feedbackMsg.innerHTML = `❌ <strong>Неверно.</strong> Правильный ответ: «${q.answers[q.correct]}». ${q.explanation}`;
      }

      // Обновляем счёт и достижения
      updateTotalScore();
      renderPlayers();
      checkAchievements(player);
      renderAchievements();

      // Активируем кнопку "Следующий вопрос"
      nextBtn.disabled = false;
    }

    // -------------------- ПРОВЕРКА ДОСТИЖЕНИЙ --------------------
    function checkAchievements(player) {
      achievementsList.forEach(ach => {
        if (!player.achievements.has(ach.id) && ach.condition(player)) {
          player.achievements.add(ach.id);
        }
      });
    }

    // -------------------- ОТРИСОВКА ДОСТИЖЕНИЙ (общий пул для простоты) --------------------
    function renderAchievements() {
      // Собираем все разблокированные достижения среди игроков
      const unlockedIds = new Set();
      players.forEach(p => p.achievements.forEach(id => unlockedIds.add(id)));

      badgesContainer.innerHTML = '';
      achievementsList.forEach(ach => {
        const badge = document.createElement('div');
        badge.className = `badge ${unlockedIds.has(ach.id) ? 'unlocked' : ''}`;
        badge.innerHTML = `<span class="badge-icon">${ach.icon}</span> ${ach.label}`;
        badgesContainer.appendChild(badge);
      });
    }

    // -------------------- СЛЕДУЮЩИЙ ВОПРОС --------------------
    function nextQuestion() {
      if (!answered || gameFinished) return;
      currentQuestionIndex++;
      if (currentQuestionIndex < TOTAL_QUESTIONS) {
        loadQuestion(currentQuestionIndex);
      } else {
        finishGame();
      }
    }

    // -------------------- ЗАВЕРШЕНИЕ ИГРЫ --------------------
    function finishGame() {
      gameFinished = true;
      updateProgress(); // 100%
      questionScreen.classList.add('hidden');
      finalScreen.classList.remove('hidden');

      // Определяем победителя
      let maxScore = -1;
      let winners = [];
      players.forEach(p => {
        if (p.score > maxScore) {
          maxScore = p.score;
          winners = [p];
        } else if (p.score === maxScore) {
          winners.push(p);
        }
      });

      if (winners.length === 1) {
        finalWinner.innerHTML = `🏆 Победитель: ${winners[0].avatar} ${winners[0].name} — ${winners[0].score} очков!`;
      } else {
        finalWinner.innerHTML = `🤝 Ничья! ${winners.map(w => `${w.avatar} ${w.name} (${w.score})`).join(', ')}`;
      }

      // Таблица очков
      let scoresHtml = '<ul style="list-style:none;">';
      players.sort((a, b) => b.score - a.score).forEach(p => {
        scoresHtml += `<li style="margin:8px 0;">${p.avatar} ${p.name}: <strong>${p.score}</strong> очков (верных: ${p.correctAnswers})</li>`;
      });
      scoresHtml += '</ul>';
      finalScores.innerHTML = scoresHtml;

      // Достижения
      renderAchievements();

      // Кнопка перезапуска
      playAgainBtn.onclick = () => {
        initGame();
        // Перезапуск отображения
        finalScreen.classList.add('hidden');
        questionScreen.classList.remove('hidden');
      };
    }

    // -------------------- ПЕРЕЗАПУСК --------------------
    function restartGame() {
      initGame();
      finalScreen.classList.add('hidden');
      questionScreen.classList.remove('hidden');
      // Сброс кнопки next
      nextBtn.disabled = true;
      nextBtn.textContent = '➡️ Следующий вопрос';
    }

    // -------------------- НАВЕШИВАНИЕ СОБЫТИЙ --------------------
    nextBtn.addEventListener('click', nextQuestion);
    restartBtn.addEventListener('click', () => {
      if (confirm('Начать игру заново? Текущий прогресс будет потерян.')) {
        restartGame();
      }
    });
    playAgainBtn.addEventListener('click', () => {
      initGame();
      finalScreen.classList.add('hidden');
      questionScreen.classList.remove('hidden');
    });

    // -------------------- СТАРТ ИГРЫ --------------------
    initGame();

    // Сохранение в localStorage (опционально, для прогресса между сессиями не требуется, но можно)
    // Здесь не реализуем сохранение, так как игра сессионная, но требование localStorage можно выполнить формально.
    // Для порядка сохраним счёт последней игры в localStorage.
    window.addEventListener('beforeunload', () => {
      try {
        localStorage.setItem(' оборотные_средства_последний_счёт', JSON.stringify(players.map(p => ({name: p.name, score: p.score}))));
      } catch (e) {}
    });

  })();
</script>
</body>
</html>
