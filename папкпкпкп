<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=yes">
    <title>Оборотные средства: Платформер знаний</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            background: #0b0e1a;
            font-family: 'Segoe UI', 'Roboto', system-ui, sans-serif;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 12px;
            color: #e0e6ff;
        }

        .game-wrapper {
            max-width: 1100px;
            width: 100%;
            background: #12182b;
            border-radius: 32px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.8), 0 0 0 2px #2a3a6a inset;
            padding: 18px;
            position: relative;
            border: 1px solid #4a5f9e;
            transition: all 0.2s;
        }

        /* fantasy dark theme */
        .header-panel {
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 16px;
            padding: 8px 12px;
            background: #0f1422;
            border-radius: 24px;
            border: 1px solid #4a5f9e;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.5), 0 0 15px #3a4a8a33;
        }

        .game-title {
            font-size: 1.3rem;
            font-weight: 700;
            background: linear-gradient(135deg, #d4b483, #f0e6c5);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            text-shadow: 0 0 8px #b8945c80;
            letter-spacing: 1px;
        }

        .stats {
            display: flex;
            gap: 18px;
            align-items: center;
        }

        .stat-badge {
            background: #1b2340;
            padding: 6px 14px;
            border-radius: 30px;
            border: 1px solid #7c8fc0;
            font-size: 1rem;
            font-weight: 600;
            color: #c0d0ff;
            box-shadow: 0 0 10px #2f3f7a;
        }

        .stat-badge span {
            color: #f5e3a8;
            font-weight: 800;
            margin-left: 6px;
        }

        .progress-bar-container {
            width: 100%;
            height: 14px;
            background: #0b0f1c;
            border-radius: 20px;
            margin: 10px 0 16px 0;
            border: 1px solid #3a4a8a;
            overflow: hidden;
            box-shadow: inset 0 2px 6px black;
        }

        .progress-fill {
            height: 100%;
            width: 0%;
            background: linear-gradient(90deg, #b8860b, #ffd966, #b8860b);
            border-radius: 20px;
            box-shadow: 0 0 12px #f0c060;
            transition: width 0.4s ease;
        }

        .game-area {
            display: flex;
            flex-direction: row;
            gap: 18px;
            flex-wrap: wrap;
        }

        .canvas-section {
            flex: 2;
            min-width: 300px;
            position: relative;
            border-radius: 24px;
            overflow: hidden;
            border: 2px solid #4a5f9e;
            box-shadow: 0 0 25px #1f2b4e, inset 0 0 20px #00000066;
            background: #0a0e18;
        }

        canvas#gameCanvas {
            display: block;
            width: 100%;
            height: auto;
            aspect-ratio: 16 / 9;
            background: radial-gradient(circle at 20% 30%, #16213e, #0a0e18);
            cursor: pointer;
            transition: filter 0.2s;
        }

        .question-panel {
            flex: 1.2;
            min-width: 280px;
            background: #0f1422;
            border-radius: 24px;
            padding: 18px;
            border: 1px solid #4a5f9e;
            box-shadow: 0 0 20px #1f2b4e;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .question-text {
            font-size: 1.1rem;
            font-weight: 500;
            line-height: 1.5;
            color: #e0e6ff;
            background: #1a2140;
            padding: 12px 16px;
            border-radius: 18px;
            border-left: 6px solid #b8860b;
            min-height: 90px;
            box-shadow: 0 2px 10px black;
        }

        .options-grid {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .option-btn {
            background: #1b2340;
            border: 2px solid #3a4f8a;
            color: #d0daff;
            padding: 12px 14px;
            border-radius: 40px;
            font-size: 0.95rem;
            font-weight: 500;
            text-align: left;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 4px 0 #0a0e18;
            letter-spacing: 0.3px;
        }

        .option-btn:hover:not(:disabled) {
            background: #2a3460;
            border-color: #b8945c;
            box-shadow: 0 0 12px #b8860b80, 0 4px 0 #0a0e18;
            color: #fff3d0;
            transform: scale(1.01);
        }

        .option-btn.correct {
            background: #1e5e3a;
            border-color: #8bc34a;
            box-shadow: 0 0 16px #8bc34a;
            color: white;
        }

        .option-btn.wrong {
            background: #5e1e2e;
            border-color: #c34a4a;
            box-shadow: 0 0 16px #c34a4a;
            color: white;
        }

        .option-btn:disabled {
            opacity: 0.7;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
        }

        .feedback-message {
            font-size: 0.95rem;
            padding: 8px 12px;
            border-radius: 30px;
            text-align: center;
            font-weight: 500;
            min-height: 40px;
            color: #f0e6c5;
        }

        .achievements-area {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            margin-top: 6px;
            justify-content: center;
        }

        .badge {
            background: #1e2340;
            border-radius: 50px;
            padding: 4px 12px;
            font-size: 0.8rem;
            border: 1px solid #b8945c;
            color: #f5e3a8;
            box-shadow: 0 0 8px #b8860b55;
            display: flex;
            align-items: center;
            gap: 4px;
            transition: all 0.3s;
            opacity: 0.6;
        }

        .badge.unlocked {
            opacity: 1;
            background: #2a3a6a;
            border-color: #ffd966;
            box-shadow: 0 0 16px #ffd966;
            color: #fff3d0;
            font-weight: 600;
        }

        .badge-icon {
            font-size: 1rem;
        }

        .btn-restart {
            background: #2a2340;
            border: 2px solid #b8860b;
            color: #f5e3a8;
            padding: 10px 18px;
            border-radius: 40px;
            font-weight: 700;
            font-size: 0.95rem;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 4px 0 #4a3a1a;
            letter-spacing: 0.5px;
        }

        .btn-restart:hover {
            background: #3f2f4a;
            box-shadow: 0 0 20px #b8860b;
            transform: scale(1.02);
        }

        .footer-info {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 12px;
            padding: 0 8px;
            font-size: 0.85rem;
            color: #8a9ad0;
        }

        /* Адаптив */
        @media (max-width: 750px) {
            .game-wrapper {
                padding: 12px;
                border-radius: 24px;
            }
            .game-title {
                font-size: 1rem;
            }
            .stats {
                gap: 8px;
            }
            .stat-badge {
                padding: 4px 10px;
                font-size: 0.8rem;
            }
            .question-text {
                font-size: 1rem;
                padding: 10px;
                min-height: 70px;
            }
            .option-btn {
                padding: 10px 12px;
                font-size: 0.9rem;
            }
            .game-area {
                flex-direction: column;
            }
        }

        @media (max-width: 480px) {
            .header-panel {
                flex-direction: column;
                align-items: flex-start;
                gap: 8px;
            }
            .stats {
                width: 100%;
                justify-content: space-between;
            }
        }
    </style>
</head>
<body>
<div class="game-wrapper">
    <!-- Шапка с прогрессом и счётом -->
    <div class="header-panel">
        <div class="game-title">🏰 ОБОРОТНЫЕ СРЕДСТВА</div>
        <div class="stats">
            <div class="stat-badge">Счёт <span id="scoreDisplay">0</span></div>
            <div class="stat-badge">Задание <span id="levelDisplay">1/15</span></div>
        </div>
    </div>

    <!-- Индикатор прогресса -->
    <div class="progress-bar-container">
        <div class="progress-fill" id="progressFill" style="width: 0%;"></div>
    </div>

    <!-- Основная игровая зона -->
    <div class="game-area">
        <!-- Canvas для платформера / визуализации -->
        <div class="canvas-section">
            <canvas id="gameCanvas" width="800" height="450"></canvas>
        </div>

        <!-- Панель с вопросом и вариантами -->
        <div class="question-panel">
            <div class="question-text" id="questionText">Загрузка вопроса...</div>
            <div class="options-grid" id="optionsContainer"></div>
            <div class="feedback-message" id="feedbackMessage">Выберите правильный ответ</div>
            
            <!-- Достижения и значки -->
            <div class="achievements-area" id="achievementsContainer">
                <div class="badge" id="badgeFirst"><span class="badge-icon">🏅</span> Первый шаг</div>
                <div class="badge" id="badgeStreak"><span class="badge-icon">🔥</span> 3 подряд</div>
                <div class="badge" id="badgeMaster"><span class="badge-icon">👑</span> Мастер</div>
            </div>

            <button class="btn-restart" id="restartBtn">🔄 Начать заново</button>
        </div>
    </div>

    <div class="footer-info">
        <span>Тема: Оборотные средства организации</span>
        <span>18+ | Сложный уровень</span>
    </div>
</div>

<script>
    // ==================== ИГРОВЫЕ ДАННЫЕ ====================
    // 15 вопросов по теме "Оборотные средства организации" (возраст 18+, сложный)
    const questions = [
        {
            q: "Что входит в состав оборотных производственных фондов?",
            options: [
