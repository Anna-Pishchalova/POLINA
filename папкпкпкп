      background: #1b212e;
      padding: 16px 22px;
      border-radius: 100px;
      margin-bottom: 24px;
      border: 2px solid #5a6c8c;
      box-shadow: 0 6px 0 #0d1016;
    }

    h1 {
      font-size: 1.9rem;
      font-weight: 700;
      letter-spacing: 1px;
      color: #ffd966;
